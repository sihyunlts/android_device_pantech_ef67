/system ext4 /dev/block/platform/msm_sdcc.1/by-name/system
/data ext4 /dev/block/platform/msm_sdcc.1/by-name/userdata
/cache ext4 /dev/block/platform/msm_sdcc.1/by-name/cache
/boot emmc /dev/block/platform/msm_sdcc.1/by-name/boot
/recovery emmc /dev/block/platform/msm_sdcc.1/by-name/recovery flags=backup=1;flashimg=1
/misc emmc /dev/block/platform/msm_sdcc.1/by-name/misc
/persist ext4 /dev/block/platform/msm_sdcc.1/by-name/persist flags=backup=1;canbewiped=0
/external_sd vfat /dev/block/mmcblk1p1 flags=storage;wipeingui;removable
/usb-otg vfat /dev/block/sda1 flags=storage;wipeingui;removable
