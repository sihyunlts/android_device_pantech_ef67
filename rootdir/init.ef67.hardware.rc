on early-init
    symlink /data/tombstones /tombstones

on post-fs-data
    chown system system /sys/devices/platform/kcal_ctrl/kcal
    chmod 0660 /sys/devices/platform/kcal_ctrl/kcal
    copy /system/etc/firmware/wlan/qca_cld/WCNSS_qcom_cfg_orgi.ini /data/misc/wifi/WCNSS_qcom_cfg.ini
    chown wifi wifi /data/misc/wifi/WCNSS_qcom_cfg.ini
    chmod 0660 /data/misc/wifi/WCNSS_qcom_cfg.ini
    restorecon /data/misc/wifi/WCNSS_qcom_cfg.ini

service wifi_mac_init /system/bin/ef67-wifi-init
    class late_start
    group wifi radio
    oneshot

service p2p_supplicant /system/bin/wpa_supplicant \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf -N \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -puse_p2p_group_interface=1 \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -ABKLG
    class late_start
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -ABKLG
    class late_start
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class late_start
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class late_start
    disabled
    oneshot

on boot
    chown system system /sys/class/leds/lp5523:channel0/brightness
    chown system system /sys/class/leds/lp5523:channel1/brightness
    chown system system /sys/class/leds/lp5523:channel2/brightness
    chown system system /sys/class/leds/lp5523:channel3/brightness
    chown system system /sys/class/leds/lp5523:channel4/brightness
    chown system system /sys/class/leds/lp5523:channel5/brightness
    chown system system /sys/class/leds/lp5523:channel6/brightness
    chown system system /sys/class/leds/lp5523:channel7/brightness
    chown system system /sys/class/leds/lp5523:channel8/brightness

on post-fs-data
    mkdir /data/misc/audio 0770 audio audio
    restorecon_recursive /data/misc/audio

on boot
    write /dev/fpc_btp stop_navi
    chown system system /sys/class/power_supply/battery/charge_enabled
    chmod 0660 /sys/class/power_supply/battery/charge_enabled
    restorecon /sys/devices/f9925000.i2c/i2c-3/3-001c/power_supply/battery/charge_enabled

on boot
    write /sys/kernel/boot_adsp/boot 1

service audiod /system/bin/audiod
    class late_start
    user system
    group system

on post-fs-data
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
    mkdir /data/misc/bluedroid 0770 bluetooth bluetooth
    restorecon_recursive /data/misc/bluetooth
    restorecon_recursive /data/misc/bluedroid

on boot
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/module/bluetooth_power/parameters/power
    chmod 0660 /sys/module/bluetooth_power/parameters/power
    chown bluetooth bluetooth /proc/bluetooth/sleep/proto
    chmod 0660 /proc/bluetooth/sleep/proto
    chown bluetooth bluetooth /sys/module/hci_uart/parameters/ath_lpm
    chmod 0660 /sys/module/hci_uart/parameters/ath_lpm
    chown bluetooth bluetooth /sys/module/hci_uart/parameters/ath_btwrite
    chmod 0660 /sys/module/hci_uart/parameters/ath_btwrite
    chown bluetooth bluetooth /sys/devices/platform/msm_serial_hs.0/clock
    chmod 0660 /sys/devices/platform/msm_serial_hs.0/clock
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/device/extldo
    chmod 0660 /sys/class/rfkill/rfkill0/device/extldo

service config_bluetooth /system/bin/btnvtool -O
    class late_start
    group bluetooth radio
    oneshot

on property:wc_transport.start_hci=true
    start start_hci_filter

on property:wc_transport.start_hci=false
    stop start_hci_filter

service start_hci_filter /system/bin/ef67-hci-filter
    class late_start
    user bluetooth
    group bluetooth
    disabled

service dhcpcd_bt-pan /system/bin/dhcpcd -BKLG
    class late_start
    disabled
    oneshot

service iprenew_bt-pan /system/bin/dhcpcd -n
    class late_start
    disabled
    oneshot

on post-fs-data
    mkdir /data/misc/mdmhelperdata 0770 radio radio
    mkdir /data/radio 0770 radio radio
    restorecon_recursive /data/radio

on boot
    insmod /system/lib/modules/mhi.ko
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /dev/socket/qmux_audio 0770 media audio
    chmod 2770 /dev/socket/qmux_audio
    mkdir /dev/socket/qmux_bluetooth 0770 bluetooth bluetooth
    chmod 2770 /dev/socket/qmux_bluetooth
    mkdir /dev/socket/qmux_gps 0770 gps gps
    chmod 2770 /dev/socket/qmux_gps

on property:ro.baseband=mdm2
    start mdm_helper
    start qmuxd
    start netmgrd

on property:ro.boot.emmc=true
    start rmt_storage

on property:sys.shutdown.requested=*
    stop mdm_helper_proxy

on property:ro.radio.noril=yes
    stop mdm_helper_proxy

on property:persist.airplane.mode.pwr.svg=enabled
    setprop ro.mdm_helper_proxy_req false

on property:init.svc.ril-daemon=running
    setprop ro.mdm_helper_proxy_req true

on property:ro.mdm_helper_proxy_req=true
    start mdm_helper_proxy

service mdm_helper /system/bin/mdm_helper
    class core
    disabled

service mdm_helper_proxy /system/bin/mdm_helper_proxy
    class core
    disabled

service rmt_storage /system/bin/rmt_storage
    class core
    disabled

service qmuxd /system/bin/qmuxd
    class main
    user radio
    group radio audio bluetooth gps qcom_diag
    disabled

service netmgrd /system/bin/netmgrd
    class main
    disabled

on post-fs-data
    mkdir /data/misc/camera 0770 camera camera
    restorecon_recursive /data/misc/camera

service qcamerasvr /system/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics

service sensors /system/bin/sensors.qcom
    class main
    user root
    group root

service irsc_util /system/bin/irsc_util /system/etc/sec_config
    class main
    user root
    oneshot

on boot
    write /sys/module/lpm_levels/enable_low_power/l2 4
    write /sys/module/msm_pm/modes/cpu0/power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu1/power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu2/power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu3/power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu0/power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu1/power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu2/power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu3/power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu0/standalone_power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu1/standalone_power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu2/standalone_power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu3/standalone_power_collapse/suspend_enabled 1
    write /sys/module/msm_pm/modes/cpu0/standalone_power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu1/standalone_power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu2/standalone_power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu3/standalone_power_collapse/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu0/retention/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu1/retention/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu2/retention/idle_enabled 1
    write /sys/module/msm_pm/modes/cpu3/retention/idle_enabled 1

on boot
    # S0226114 uses measured bandwidth to scale the CPU memory bus.
    write /sys/class/devfreq/qcom,cpubw.28/governor cpubw_hwmon
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "20000 1400000:40000 1700000:20000"
    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 90
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1497600
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "85 1500000:90 1800000:70"
    write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 40000
    write /sys/devices/system/cpu/cpufreq/interactive/sampling_down_factor 100000
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_min_freq 300000

service thermal-engine /system/bin/thermal-engine
    class main
    user root
    group root

service mpdecision /system/bin/mpdecision --avg_comp
    class main
    user root

on post-fs-data
    mkdir /data/misc/gpsone_d 0770 system gps
    mkdir /data/misc/location 0770 gps gps
    mkdir /data/misc/location/mq 0770 gps gps
    restorecon_recursive /data/misc/gpsone_d
    restorecon_recursive /data/misc/location
    mkdir /data/nfc 0770 nfc nfc
    mkdir /data/nfc/param 0770 nfc nfc
    restorecon_recursive /data/nfc

on init
    # The CM11 PN547 HAL uses this name for the stock NFC device.
    symlink /dev/pn547 /dev/pn544

service gpsone_daemon /system/bin/gpsone_daemon
    class late_start
    user gps
    group gps inet net_raw
    disabled

on boot
    chown system system /sys/bus/i2c/devices/1-004a/double_tap_to_wake
    chmod 0660 /sys/bus/i2c/devices/1-004a/double_tap_to_wake
    restorecon /sys/devices/f9966000.i2c/i2c-1/1-004a/double_tap_to_wake
