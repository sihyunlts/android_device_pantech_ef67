From: Sihyun Baek <62822977+sihyunlts@users.noreply.github.com>
Date: Wed, 14 Oct 2026 01:50:07 +0900
Subject: [PATCH 4/6] display: use VIG pipes for vertical downscaling

Select QSEED2-capable VIG pipes after crop and rotation handling when a layer needs vertical downscaling.

The kernel accepts vertical phase overflow on VIG QSEED2 and requests GPU fallback for RGB. This CM11 selection is not an equivalent backport of the CM12 RGB-scaler capability change.
---
 libhwcomposer/hwc_mdpcomp.cpp | 11 ++++++++++-
 libhwcomposer/hwc_utils.cpp   | 11 +++++++++++
 libhwcomposer/hwc_utils.h     |  2 ++
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/libhwcomposer/hwc_mdpcomp.cpp b/libhwcomposer/hwc_mdpcomp.cpp
index 13333ef..fdd479b 100644
--- a/libhwcomposer/hwc_mdpcomp.cpp
+++ b/libhwcomposer/hwc_mdpcomp.cpp
@@ -1051,6 +1051,11 @@ bool MDPCompLowRes::allocLayerPipes(hwc_context_t *ctx,
 
         ePipeType type = MDPCOMP_OV_ANY;
 
+        // QSEED2 on VIG pipes handles vertical downscale phase overflow.
+        if(ctx->mMDP.version >= qdutils::MDSS_V5 &&
+                needsVerticalDownscale(ctx, layer, mDpy))
+            type = MDPCOMP_OV_VG;
+
         if(!qhwc::needsScaling(ctx,layer,mDpy) && !ctx->mNeedsRotator
            && ctx->mMDP.version >= qdutils::MDSS_V5) {
             type = MDPCOMP_OV_DMA;
@@ -1227,6 +1232,11 @@ bool MDPCompHighRes::allocLayerPipes(hwc_context_t *ctx,
 
         ePipeType type = MDPCOMP_OV_ANY;
 
+        // QSEED2 on VIG pipes handles vertical downscale phase overflow.
+        if(ctx->mMDP.version >= qdutils::MDSS_V5 &&
+                needsVerticalDownscale(ctx, layer, mDpy))
+            type = MDPCOMP_OV_VG;
+
         if(!qhwc::needsScaling(ctx,layer,mDpy) && !ctx->mNeedsRotator
            && ctx->mMDP.version >= qdutils::MDSS_V5)
             type = MDPCOMP_OV_DMA;
@@ -1346,4 +1356,3 @@ bool MDPCompHighRes::draw(hwc_context_t *ctx, hwc_display_contents_1_t* list) {
     return true;
 }
 }; //namespace
-
diff --git a/libhwcomposer/hwc_utils.cpp b/libhwcomposer/hwc_utils.cpp
index 5579e85..98a01c8 100644
--- a/libhwcomposer/hwc_utils.cpp
+++ b/libhwcomposer/hwc_utils.cpp
@@ -714,6 +714,17 @@ bool needsScaling(hwc_context_t* ctx, hwc_layer_1_t const* layer,
     return false;
 }
 
+bool needsVerticalDownscale(hwc_context_t* ctx, hwc_layer_1_t const* layer,
+        const int& dpy) {
+    hwc_rect_t crop = integerizeSourceCrop(layer->sourceCropf);
+    hwc_rect_t dst = layer->displayFrame;
+    trimLayer(ctx, dpy, layer->transform, crop, dst);
+
+    const int srcHeight = (layer->transform & HWC_TRANSFORM_ROT_90) ?
+            crop.right - crop.left : crop.bottom - crop.top;
+    return srcHeight > dst.bottom - dst.top;
+}
+
 bool isAlphaScaled(hwc_context_t* ctx, hwc_layer_1_t const* layer,
         const int& dpy) {
     if(needsScaling(ctx, layer, dpy) && isAlphaPresent(layer)) {
diff --git a/libhwcomposer/hwc_utils.h b/libhwcomposer/hwc_utils.h
index bd389d3..74175de 100644
--- a/libhwcomposer/hwc_utils.h
+++ b/libhwcomposer/hwc_utils.h
@@ -205,6 +205,8 @@ bool isSecuring(hwc_context_t* ctx, hwc_layer_1_t const* layer);
 bool isSecureModePolicy(int mdpVersion);
 bool isExternalActive(hwc_context_t* ctx);
 bool needsScaling(hwc_context_t* ctx, hwc_layer_1_t const* layer, const int& dpy);
+bool needsVerticalDownscale(hwc_context_t* ctx, hwc_layer_1_t const* layer,
+        const int& dpy);
 bool isAlphaPresent(hwc_layer_1_t const* layer);
 bool setupBasePipe(hwc_context_t *ctx);
 int hwc_vsync_control(hwc_context_t* ctx, int dpy, int enable);
