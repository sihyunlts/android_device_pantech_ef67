type vega_settings, domain;
app_domain(vega_settings)

# Framework service discovery required by a platform-signed settings app.
allow vega_settings { app_api_service system_api_service }:service_manager find;
allow vega_settings surfaceflinger_service:service_manager find;

type ef67_touch_device, dev_type;
type ef67_charge_control_sysfs, fs_type, sysfs_type;

allow vega_settings system_app_data_file:dir create_dir_perms;
allow vega_settings system_app_data_file:file create_file_perms;
allow vega_settings self:netlink_kobject_uevent_socket { create bind read getattr setopt };
allow vega_settings ef67_touch_device:chr_file { open read ioctl getattr };
allow vega_settings ef67_charge_control_sysfs:file { getattr open write };
# Preserve the thermal service's access when this file gains a specific label.
allow thermal-engine ef67_charge_control_sysfs:file { getattr open read write };
