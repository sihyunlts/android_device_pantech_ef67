# EF67 stock sensors use cam_socket2 and cam_socket3.
type_transition mm-qcamerad system_data_file:sock_file camera_socket "cam_socket2";
type_transition mm-qcamerad system_data_file:sock_file camera_socket "cam_socket3";

# Stock camera sockets are created directly under /data.
allow mm-qcamerad system_data_file:dir w_dir_perms;

# The Oreo common policy leaves legacy camera socket creation disabled.
allow mm-qcamerad camera_socket:sock_file { create unlink write };

# Camera1 runs in mediaserver and sends requests to these camera sockets.
unix_socket_send(mediaserver, camera, mm-qcamerad)
