# Apply the existing charge and navigation control ownership at boot.
allow init { ef67_charge_control_sysfs ef67_fingerprint_navigation_sysfs }:file { open read setattr };

# Apply only the existing governor and its six tuning controls.
allow init ef67_cpu_frequency_sysfs:file { open write };

# The common policy grants write, but init must first open the ADSP boot control.
allow init sysfs_boot_adsp:file open;
