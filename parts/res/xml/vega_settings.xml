<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/v_pen">
        <ListPreference android:key="touch_mode" android:title="@string/touch_mode"
            android:entries="@array/touch_mode_entries" android:entryValues="@array/touch_mode_values"
            android:summary="@string/touch_mode_summary" android:persistent="false" />
        <CheckBoxPreference android:key="pen_auto_mode" android:title="@string/pen_auto_mode"
            android:defaultValue="false" />
        <CheckBoxPreference android:key="pen_notification" android:title="@string/pen_notification"
            android:summary="@string/pen_notification_summary" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/secret_key">
        <ListPreference android:key="key_assist_action" android:title="@string/hardware_keys_short_press_title"
            android:entries="@array/secret_key_actions" android:entryValues="@array/secret_key_values"
            android:persistent="false" />
        <ListPreference android:key="key_assist_long_press_action" android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/secret_key_actions" android:entryValues="@array/secret_key_values"
            android:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/charging">
        <ListPreference android:key="charging_limit" android:title="@string/charging_limit"
            android:entries="@array/charging_limit_entries" android:entryValues="@array/charging_limit_values"
            android:summary="%s" android:defaultValue="0" />
    </PreferenceCategory>
</PreferenceScreen>
